{
  "name": "ai-political-poster-backend",
  "version": "1.0.0",
  "description": "Express TypeScript Backend for AI Political Poster Maker",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.js --external:mongoose --external:express --external:bcryptjs --external:jsonwebtoken --external:sharp",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seeds/seedTemplates.ts"
  },
  "keywords": ["ai", "gemini", "poster-maker", "bangladesh", "express", "typescript", "mongodb"],
  "author": "SadaSaad",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
